---
import { getCollection } from 'astro:content';
import HandRule from './HandRule.astro';
import { url, formatDate } from '../lib/utils';
interface Props { title?: string; }
const { title = 'Talks & sessions' } = Astro.props;
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
{talks.length > 0 && (
<section class="wrap talks" aria-labelledby="talks-h">
  <h2 id="talks-h" class="section-title">{title}</h2>
  <ul>
    {talks.map((t, i) => (
      <li>
        <HandRule seed={i + 70} />
        <article class="talk">
          <p class="eyebrow">{t.data.format} · <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time></p>
          <div class="main">
            <h3>{t.data.post ? <a href={url(`research/${t.data.post.id}/`)}>{t.data.title}</a> : t.data.title}</h3>
            <p class="host">{t.data.host}</p>
            <p class="summary">{t.data.summary}</p>
            <p class="links">
              {t.data.post && <a href={url(`research/${t.data.post.id}/`)}>Read the write-up →</a>}
              {t.data.source && <a href={t.data.source} target="_blank" rel="noopener">Host's page ↗</a>}
            </p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
)}
<style>
  .talks { padding-block: 40px 16px; }
  .section-title { font-size: 28px; margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .talk { display: grid; grid-template-columns: minmax(160px, 1fr) 3fr; gap: 8px 32px; padding-block: 20px 28px; }
  h3 { font-size: 26px; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .host { margin: 6px 0 0; font-size: 14px; font-weight: 500; }
  .summary { margin: 10px 0 0; color: var(--ink-soft); max-width: 60ch; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 14px 0 0; font-size: 14px; }
  .links a { color: var(--heading); }
  @media (max-width: 640px) { .talk { grid-template-columns: 1fr; } }
</style>
