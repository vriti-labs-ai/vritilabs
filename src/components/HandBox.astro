---
// Wraps content in a hand-drawn rectangle border (Rough.js, build time).
import rough from 'roughjs';
interface Props { seed?: number; class?: string; }
const { seed = 1, class: cls = '' } = Astro.props;
const gen = rough.generator();
const paths = gen.toPaths(gen.rectangle(2, 2, 396, 296, { seed, roughness: 1.1, strokeWidth: 1 }));
---
<div class:list={['hand-box', cls]}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
    {paths.map((p) => <path d={p.d} fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" />)}
  </svg>
  <div class="inner"><slot /></div>
</div>
<style>
  .hand-box { position: relative; color: var(--ink); }
  .hand-box svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .inner { position: relative; padding: 20px; }
</style>
