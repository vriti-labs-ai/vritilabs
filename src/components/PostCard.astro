---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/utils';
interface Props { post: CollectionEntry<'posts'>; teamName: string; }
const { post, teamName } = Astro.props;
const { title, summary, date, image, imageAlt, team } = post.data;
const href = url(`research/${post.id}/`);
---
<article class="card" data-team={team.id} data-date={date.toISOString()}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    {image ? <img src={url(image)} alt={imageAlt} loading="lazy" /> : <div class="blank" />}
  </a>
  <div class="body">
    <p class="eyebrow">
      <a href={url(`solutions/${team.id}/`)}>{teamName}</a> · <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 16px; }
  .media { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); }
  .media img, .blank { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card:hover .media img { transform: scale(1.03); }
  .body { display: flex; flex-direction: column; gap: 8px; }
  h3 { font-size: 22px; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .summary { margin: 0; color: var(--ink-soft); font-size: 15px; }
</style>
