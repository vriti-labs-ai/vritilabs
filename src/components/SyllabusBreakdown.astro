---
import type { CollectionEntry } from 'astro:content';
interface Props { syllabus: CollectionEntry<'syllabi'> }
const { lecture0, parts, milestones } = Astro.props.syllabus.data;
type Lecture = NonNullable<typeof lecture0>;
// Readings without a direct link open a Google Scholar search for the title.
const href = (p: { title: string; url?: string }) =>
  p.url ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(p.title)}`;
const all: Lecture[] = [...(lecture0 ? [lecture0] : []), ...parts.flatMap((p) => p.items)];
const lectureCount = parts.reduce((n, p) => n + p.items.length, 0);
---
<section class="syllabus" aria-labelledby="syllabus-h">
  <div class="top">
    <h3 id="syllabus-h">Detailed course breakdown</h3>
    <p class="note">{lectureCount} lectures in {parts.length} parts. Each lecture is theory and intuition, then programming. Open a lecture to see what it covers.</p>
  </div>

  {[{ title: 'Before you start', lectures: 'Optional', blurb: 'A bridge session for the most common gaps, taken before the course begins.', items: lecture0 ? [lecture0] : [] }, ...parts]
    .filter((p) => p.items.length > 0)
    .map((part, pi) => (
      <div class="part">
        <p class="eyebrow">{pi === 0 && lecture0 ? part.lectures : `Part ${lecture0 ? pi : pi + 1} · ${part.lectures}`}</p>
        <h4>{part.title}</h4>
        <p class="blurb">{part.blurb}</p>
        <ul class="lectures">
          {part.items.map((l) => (
            <li>
              <details>
                <summary>
                  <span class="num" aria-hidden="true">{l.number}</span>
                  <span class="head">
                    <b><span class="sr">Lecture {l.number}: </span>{l.title}</b>
                    {l.fixes && <small>{l.fixes}</small>}
                  </span>
                  <span class="tags">
                    {l.milestone && <span class="ms">{l.milestone}</span>}
                    <span class="toggle" aria-hidden="true"></span>
                  </span>
                </summary>
                <div class="body">
                  {(l.buildsOn || l.folder) && (
                    <p class="meta">
                      {l.buildsOn && <span><em>Builds on</em> {l.buildsOn}</span>}
                      {l.folder && <code>{l.folder}</code>}
                    </p>
                  )}
                  {(l.fixes || l.leavesOpen) && (
                    <dl class="chain">
                      {l.fixes && <div><dt>Fixes</dt><dd>{l.fixes}</dd></div>}
                      {l.leavesOpen && <div><dt>Leaves open</dt><dd>{l.leavesOpen}</dd></div>}
                    </dl>
                  )}
                  <div class="halves">
                    <section><h5>Theory and intuition</h5><p>{l.theory}</p></section>
                    <section><h5>Programming</h5><p>{l.programming}</p></section>
                  </div>
                  {l.papers.length > 0 && (
                    <div class="papers">
                      <h5>{l.number === 0 ? 'Reading' : 'Papers'} <span>({l.papers.length})</span></h5>
                      <ul>
                        {l.papers.map((p) => (
                          <li><a href={href(p)} target="_blank" rel="noopener noreferrer">{p.title}</a> <span class="cite">{p.cite}</span></li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}

  {milestones.length > 0 && (
    <div class="part">
      <p class="eyebrow">Capstone</p>
      <h4>Four milestones</h4>
      <ol class="milestones">
        {milestones.map((m) => (
          <li><span class="mid">{m.id}</span><small>{m.after}</small><b>{m.title}</b><p>{m.text}</p></li>
        ))}
      </ol>
    </div>
  )}
  <p class="fine">Paper titles without a direct link open a Google Scholar search.</p>
</section>

<style>
  .syllabus { margin-top: 56px; }
  .top h3 { font-size: 26px; margin-bottom: 8px; }
  .note { margin: 0; color: var(--ink-soft); max-width: 62ch; }
  .part { margin-top: 36px; }
  .part h4 { font-family: var(--serif); font-weight: 400; font-size: 22px; color: var(--heading); margin: 4px 0 4px; }
  .blurb { margin: 0 0 12px; font-size: 15px; color: var(--ink-soft); max-width: 70ch; }

  .lectures { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .lectures > li { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 16px; align-items: center;
    padding: 14px 4px;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--paper-2); }
  .num { font-family: var(--serif); font-size: 34px; line-height: 1; color: var(--heading); text-align: right; font-variant-numeric: tabular-nums; }
  .head b { display: block; font-weight: 500; font-size: 17px; line-height: 1.3; }
  .head small { display: block; font-size: 13.5px; color: var(--ink-soft); margin-top: 2px; }
  .tags { display: flex; align-items: center; gap: 10px; }
  .ms { font-size: 11.5px; font-weight: 500; border: 1px solid var(--ink); background: var(--tile-bg); padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
  .toggle { width: 22px; height: 22px; border: 1.5px solid var(--ink); border-radius: 50%; position: relative; flex: none; }
  .toggle::before, .toggle::after { content: ''; position: absolute; left: 50%; top: 50%; background: var(--ink); transform: translate(-50%, -50%); }
  .toggle::before { width: 10px; height: 1.5px; }
  .toggle::after { width: 1.5px; height: 10px; }
  details[open] .toggle::after { display: none; }

  .body { padding: 4px 4px 22px 76px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0 0 12px; font-size: 13.5px; }
  .meta em { font-style: normal; font-weight: 500; }
  .meta code { font-size: 12.5px; background: var(--paper-2); padding: 2px 8px; border-radius: 4px; }
  .chain { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin: 0 0 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-2); }
  .chain div { padding: 10px 14px; }
  .chain div + div { border-left: 1px solid var(--line); }
  .chain dt { font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; font-weight: 500; }
  .chain dd { margin: 3px 0 0; font-size: 14.5px; }
  .halves { display: grid; gap: 20px 32px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  h5 { font-family: var(--sans); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; color: var(--ink-soft); margin: 0 0 6px; }
  .halves p { margin: 0; font-size: 15px; }
  .papers { margin-top: 16px; }
  .papers h5 span { font-weight: 400; }
  .papers ul { margin: 0; padding-left: 18px; display: grid; gap: 5px; font-size: 14.5px; }
  .papers a { color: var(--heading); text-underline-offset: 3px; }
  .cite { color: var(--ink-soft); }

  .milestones { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); border-top: 1.5px solid var(--ink); }
  .milestones li { padding-top: 12px; display: flex; flex-direction: column; gap: 3px; }
  .mid { font-family: var(--serif); font-size: 30px; line-height: 1; color: var(--heading); }
  .milestones small { font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-soft); }
  .milestones b { font-weight: 500; font-size: 16px; }
  .milestones p { margin: 0; font-size: 14.5px; }
  .fine { margin: 20px 0 0; font-size: 12.5px; color: var(--ink-soft); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 640px) {
    summary { grid-template-columns: 40px minmax(0, 1fr) auto; gap: 10px; }
    .num { font-size: 26px; }
    .body { padding-left: 4px; }
    .ms { display: none; }
    .chain div + div { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
