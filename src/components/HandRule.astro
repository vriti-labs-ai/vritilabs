---
// A hand-drawn horizontal rule, rendered at build time with Rough.js (no client JS).
import rough from 'roughjs';
interface Props { seed?: number; roughness?: number; }
const { seed = 1, roughness = 1.4 } = Astro.props;
const gen = rough.generator();
const paths = gen.toPaths(gen.line(2, 6, 998, 6, { seed, roughness, bowing: 2, strokeWidth: 1.2 }));
---
<svg class="hand-rule" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true">
  {paths.map((p) => <path d={p.d} fill="none" stroke="currentColor" stroke-width={p.strokeWidth} vector-effect="non-scaling-stroke" />)}
</svg>
<style>
  .hand-rule { display: block; width: 100%; height: 12px; color: var(--ink); }
</style>
